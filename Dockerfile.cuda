# 使用 NVIDIA CUDA 官方镜像 (Python 3.10 + CUDA 12.3)
FROM nvidia/cuda:12.3.1-runtime-ubuntu22.04

# 设置环境变量避免交互式提示
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# 安装 Python 3.10
RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.10 \
    python3.10-venv \
    python3.10-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# 设置 Python 3.10 为默认 python3
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 \
    && update-alternatives --install /usr/bin/pip3 pip3 /usr/bin/pip3

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-chi-sim \
    libgl1-mesa-glx \
    libglib2.0-0 \
    build-essential \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# 升级 pip
RUN pip3 install --upgrade pip

# 复制 requirements.txt 并安装 Python 依赖
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# 复制项目代码
COPY agents/ ./agents/
COPY tools/ ./tools/
COPY run/ ./run/

# 创建数据目录（会被 volume 覆盖）
RUN mkdir -p /app/data/storages \
    /app/data/content_lists \
    /app/data/exported_chunks \
    /app/data/stored_files \
    /app/.user

# 暴露 Streamlit 默认端口
EXPOSE 8501

# 设置环境变量
ENV PYTHONUNBUFFERED=1
ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# 启动 Streamlit 应用
CMD ["streamlit", "run", "run/streamlit.py", "--server.port=8501", "--server.address=0.0.0.0"]
