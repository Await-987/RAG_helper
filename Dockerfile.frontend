# 使用固定 Node 22 Bookworm Slim 镜像构建前端静态资源。
FROM node:22-bookworm-slim AS builder

# 构建阶段接收大写 HTTP 代理变量。
ARG HTTP_PROXY
# 构建阶段接收大写 HTTPS 代理变量。
ARG HTTPS_PROXY
# 构建阶段接收大写 NO_PROXY 变量。
ARG NO_PROXY
# 构建阶段接收小写 http_proxy 变量。
ARG http_proxy
# 构建阶段接收小写 https_proxy 变量。
ARG https_proxy
# 构建阶段接收小写 no_proxy 变量。
ARG no_proxy

# 设置前端构建工作目录。
WORKDIR /frontend

# 先复制 package 清单，利用 Docker 层缓存。
COPY frontend/package.json frontend/package-lock.json ./
# 安装前端依赖，并在需要时使用宿主机代理。
RUN export HTTP_PROXY="${HTTP_PROXY}" HTTPS_PROXY="${HTTPS_PROXY}" NO_PROXY="${NO_PROXY}" \
    http_proxy="${http_proxy:-$HTTP_PROXY}" https_proxy="${https_proxy:-$HTTPS_PROXY}" no_proxy="${no_proxy:-$NO_PROXY}" \
    && npm ci

# 复制前端源码。
COPY frontend ./
# 构建前端生产静态资源。
RUN npm run build

# 使用官方 Nginx 镜像承载构建好的静态文件。
FROM nginx:alpine

# 复制自定义 Nginx 配置。
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
# 把构建产物复制到 Nginx 默认静态目录。
COPY --from=builder /frontend/dist /usr/share/nginx/html

# 声明 Nginx 对外监听端口。
EXPOSE 80

# 定义前端容器健康检查逻辑。
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q -O- http://localhost/healthz >/dev/null 2>&1 || exit 1
